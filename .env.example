# Copy to `.env` (`just gateway-up` does it for you on first run) and change the secrets.
# `.env` is ignored by Git. Never commit real keys.

# Admin key of the gateway. Must start with "sk-". Used to call the API and to create team keys.
# Generate one with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-local-dev-master-key

# Encrypts provider credentials stored in the database. Set it once: changing it later makes them unreadable.
# Generate one with: openssl rand -hex 32
LITELLM_SALT_KEY=local-dev-salt-key

# Virtual keys of the client teams (config/tenants.yaml). Must start with "sk-".
# Teams call the gateway with these, never with the master key.
# Generate one with: echo "sk-$(openssl rand -hex 24)"
TEAM_KEY_F1=sk-local-dev-team-f1
TEAM_KEY_MJ=sk-local-dev-team-mj
TEAM_KEY_BAUX=sk-local-dev-team-baux

# PostgreSQL holds virtual keys, budgets and spend.
# LiteLLM receives postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB, built in compose.yaml.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=litellm

# Ollama models downloaded on first start (about 2 GB in total), separated by spaces.
# Must match the models declared in config/litellm.yaml.
OLLAMA_MODELS="qwen2.5:0.5b qwen2.5:1.5b granite-embedding:278m"

# Host port of the gateway, bound to 127.0.0.1 only.
LITELLM_PORT=4000

# Host ports of Presidio Analyzer and Anonymizer, bound to 127.0.0.1 only. Only needed to call them directly.
PRESIDIO_ANALYZER_PORT=5002
PRESIDIO_ANONYMIZER_PORT=5001

# Host port of the ollama server, bound to 127.0.0.1 only. Used by the benchmark to query models directly.
# Not 11434, which a local Ollama install usually holds.
OLLAMA_PORT=11435
