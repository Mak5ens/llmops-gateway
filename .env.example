# Copy to `.env` (`just gateway-up` does it for you on first run) and change the secrets.
# `.env` is ignored by Git. Never commit real keys.

# Admin key of the gateway. Must start with "sk-". Used to call the API and to create team keys.
# Generate one with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-local-dev-master-key

# Encrypts provider credentials stored in the database. Set it once: changing it later makes them unreadable.
# Generate one with: openssl rand -hex 32
LITELLM_SALT_KEY=local-dev-salt-key

# PostgreSQL holds virtual keys, budgets and spend.
# LiteLLM receives postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB, built in compose.yaml.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=litellm

# Ollama model downloaded on first start (about 400 MB). Must match the model in config/litellm.yaml.
OLLAMA_MODEL=qwen2.5:0.5b

# Host port of the gateway, bound to 127.0.0.1 only.
LITELLM_PORT=4000
